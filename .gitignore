# Personal raw exports and local datasets
Google/raw/

# Soft-archived modules (do not delete; may contain private history)
_recycle/

# Structured and analytical outputs are reproducible and may contain private content.
Google/structured/*
!Google/structured/README.md
!Google/structured/scripts/
!Google/structured/scripts/**

# Agent: only structured/db remains in main tree
Agent/structured/*
!Agent/structured/README.md
!Agent/structured/db/
!Agent/structured/db/**

integration/raw_index/
integration/structured/
integration/analysis/
integration/db/

# Import batches, duplicate manifests, and quarantine may include private file names.
imports/*
!imports/README.md

# Local generated data and binary outputs
*.sqlite
*.sqlite-*
*.db
*.db-*
*.csv
*.tsv
*.json
*.jsonl
*.xlsx
*.xls
*.parquet
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.html
*.tar
*.tar.gz
*.zip

# Python and local tooling caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Local agent/tooling workdirs and runtime logs (not source)
.ai-bridge/
.workbuddy/
logs/

# OS/editor noise
.DS_Store
Thumbs.db
*.log
*.$*.bkp
.$*.bkp

# Allow package manifests under apps (otherwise blocked by *.json)
!integration/apps/**/package.json
!integration/apps/**/package-lock.json
!integration/apps/**/*.mjs
!integration/apps/**/*.html
!integration/apps/**/*.md
